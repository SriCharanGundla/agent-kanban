# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_kanban_dev

# Test Database (optional - defaults to DATABASE_URL if not set)
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_kanban

# JWT (generate JWT_SECRET_KEY with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:7654"]
ENVIRONMENT=development
DEBUG=true
